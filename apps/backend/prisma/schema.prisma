datasource db {
  provider = "sqlite"
}

generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

model Job {
  id           Int            @id @default(autoincrement())
  title        String
  description  String?
  company      String?
  location     String?
  modality     String?
  level        String         @default("Not specified")
  technologies String?
  source       String?
  link         String         @unique
  publishedAt  DateTime?
  collectedAt  DateTime       @default(now())
  contractType String?
  salaryText   String?
  contactsText String?
  jobStates    UserJobState[]

  @@map("jobs")
}

model CollectionState {
  id                   Int       @id @default(autoincrement())
  source               String
  queryKey             String
  lastRun              DateTime
  lastPublicationFound DateTime?
  updatedAt            DateTime  @updatedAt

  @@unique([source, queryKey])
  @@map("collection_states")
}

model User {
  id        Int            @id @default(autoincrement())
  email     String         @unique
  password  String
  createdAt    DateTime       @default(now())
  jobStates    UserJobState[]
  savedFilters String?

  @@map("users")
}

model UserJobState {
  id         Int      @id @default(autoincrement())
  userId     Int
  jobId      Int
  isFavorite Boolean  @default(false)
  isApplied  Boolean  @default(false)
  isViewed   Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("user_job_states")
}
